# ==============================================================================
# Project Mentor AI - Root Environment Configuration Example
# Copy this file to .env before running `docker-compose up --build`
# ==============================================================================

# --- Required: Google Gemini AI API Key ---
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Gemini Model Configuration ---
# Options: gemini-flash-latest (recommended for low latency), gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-flash-latest

# --- Optional: Google Cloud Firestore (Leave empty for zero-cost local JSON storage) ---
# If empty, the system automatically uses self-hosted local JSON fallback in ./data/memory/local_store.json
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- User & Environment Defaults ---
USER_NAME=Sir
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Storage & System Automations ---
KNOWLEDGE_DIR=./knowledge
CHROMA_PERSIST_DIR=./data/chroma
ALLOW_SYSTEM_CONTROL=true
