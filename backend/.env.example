# ==============================================================================
# Project Mentor AI - Backend Environment Configuration Example
# Copy this file to `backend/.env` for local standalone development
# ==============================================================================

# [Required] Google Gemini API Key (Free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-flash-latest (recommended), gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-flash-latest

# User personalization
USER_NAME=Sir
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Local ChromaDB Vector Store & Knowledge Documents Path
KNOWLEDGE_DIR=../knowledge
CHROMA_PERSIST_DIR=./data/chroma

# Enable Desktop/OS Automation Actions (Open apps, launch sites, locks)
ALLOW_SYSTEM_CONTROL=true

# [Optional] Google Cloud Firestore (Leave blank to use zero-cost local JSON storage)
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
